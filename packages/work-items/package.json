{
  "name": "@cogni-dao/work-items",
  "version": "0.1.5",
  "license": "LicenseRef-PolyForm-Shield-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cogni-DAO/node-template.git",
    "directory": "packages/work-items"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./markdown": {
      "types": "./dist/adapters/markdown/index.d.ts",
      "import": "./dist/adapters/markdown/index.js",
      "default": "./dist/adapters/markdown/index.js"
    },
    "./adapters/doltgres": {
      "types": "./dist/adapters/doltgres/index.d.ts",
      "import": "./dist/adapters/doltgres/index.js",
      "default": "./dist/adapters/doltgres/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "postbuild": "node -e \"const fs=require('fs'); if(!fs.existsSync('dist/index.js')){console.error('ERROR: dist/index.js missing'); process.exit(1)}\"",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "type-fest": "^5.4.1",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "postgres": "^3.4.5",
    "tsup": "^8.5.1",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.1.4"
  }
}
